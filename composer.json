{
    "name": "wilsenhc/laravel-rif-validation",
    "description": "A Validation rule to check if a RIF is valid",
    "keywords": [
        "wilsenhc",
        "seniat",
        "rif",
        "laravel-rif-validation",
        "laravel-validar-rif"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Wilsen Hernández",
            "email": "wilsenforwork@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "wilsenhc/rif-validation": "^1.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "Wilsenhc\\RifValidation\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wilsenhc\\RifValidation\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel" : {
            "providers" : [
                "Wilsenhc\\RifValidation\\RifValidationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
